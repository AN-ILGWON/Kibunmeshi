<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kibunmeshi.repository.EmotionMapper">

    <resultMap id="EmotionResultMap" type="com.kibunmeshi.domain.Emotion">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="label" column="label"/>
        <result property="emoji" column="emoji"/>
        <result property="colorCode" column="color_code"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findAll" resultMap="EmotionResultMap">
        SELECT id, name, label, emoji, color_code, created_at
        FROM emotions
        ORDER BY id ASC
    </select>

    <select id="findById" resultMap="EmotionResultMap">
        SELECT id, name, label, emoji, color_code, created_at
        FROM emotions
        WHERE id = #{id}
    </select>

</mapper>

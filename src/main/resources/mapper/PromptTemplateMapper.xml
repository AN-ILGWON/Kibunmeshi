<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kibunmeshi.repository.PromptTemplateMapper">

    <resultMap id="PromptTemplateResultMap" type="com.kibunmeshi.domain.PromptTemplate">
        <id property="id" column="id"/>
        <result property="emotion" column="emotion"/>
        <result property="genre" column="genre"/>
        <result property="template" column="template"/>
        <result property="isActive" column="is_active"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByEmotionAndGenre" resultMap="PromptTemplateResultMap">
        SELECT id, emotion, genre, template, is_active, created_at, updated_at
        FROM prompt_templates
        WHERE (emotion = #{emotion} OR emotion IS NULL)
          AND (genre = #{genre} OR genre IS NULL)
          AND is_active = TRUE
        ORDER BY emotion DESC, genre DESC
        LIMIT 1
    </select>

</mapper>
